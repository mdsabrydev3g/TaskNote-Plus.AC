# ---------------------------------------------------------------------------
# TaskNote Plus - environment template
# Copy to `.env.local` for local dev, and set the same keys in Vercel.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string (Neon dashboard -> Connection Details).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/tasknote?sslmode=require"

# Neon direct (non-pooled) connection, used only by migrations/seed.
# Optional: falls back to DATABASE_URL when empty.
DATABASE_URL_UNPOOLED=""

# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public base URL of the deployment (used for cookie + origin checks).
APP_URL="http://localhost:3000"

# --- Optional AI gateway -----------------------------------------------------
# When AI_API_KEY is empty the app runs in deterministic offline mode
# (LocalNoopProvider). No core flow depends on AI.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_MONTHLY_TOKEN_BUDGET="200000"
